model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        AnnouncementType @default(TEXT)
  youtubeUrl  String?          // YouTube video URL (if type = VIDEO)
  imageKey    String?          // R2 key for announcement image (optional)
  isActive    Boolean  @default(true)
